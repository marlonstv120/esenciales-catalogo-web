          <mxGeometry x="1210" y="405" width="310" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="security-note" value="&lt;b&gt;Seguridad del cliente&lt;/b&gt;&lt;br&gt;La clave publica o publicable puede viajar en el navegador. La autorizacion real depende de RLS, permisos y funciones. Nunca se expone una clave administrativa o service_role." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#E57B25;fontColor=#7C2D12;fontSize=12;spacing=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="330" y="550" width="770" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="whatsapp" value="&lt;b&gt;WhatsApp&lt;/b&gt;&lt;br&gt;Continuacion comercial voluntaria&lt;br&gt;despues de registrar la solicitud" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#34A77B;fontColor=#14532D;fontSize=12;spacing=10;align=left;" vertex="1" parent="1">
          <mxGeometry x="50" y="550" width="220" height="85" as="geometry"/>
        </mxCell>

        <mxCell id="rules-container" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#334155;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="50" y="680" width="1490" height="245" as="geometry"/>
        </mxCell>
        <mxCell id="rules-title" value="DONDE SE GARANTIZAN LAS REGLAS PRINCIPALES" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=13;fontStyle=1;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry x="70" y="695" width="500" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="rules-left" value="&lt;b&gt;Restricciones de PostgreSQL&lt;/b&gt;&lt;br&gt;1. Precios positivos y promocion menor al precio normal: CHECK.&lt;br&gt;2. Stock no negativo y Bajo pedido con stock cero: CHECK.&lt;br&gt;3. Codigos, referencias y posiciones unicas: UNIQUE.&lt;br&gt;4. Relaciones historicas del catalogo y solicitudes: claves foraneas." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="70" y="735" width="690" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="rules-right" value="&lt;b&gt;RLS y funciones RPC&lt;/b&gt;&lt;br&gt;5. El visitante solo accede al catalogo publicable: RLS.&lt;br&gt;6. Las operaciones administrativas requieren Auth y autorizacion.&lt;br&gt;7. Registro, edicion, confirmacion y cancelacion: funciones RPC.&lt;br&gt;8. Descuento y restitucion de inventario: transacciones con bloqueos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Principio:&lt;/b&gt; el frontend mejora la experiencia, pero no es la barrera de seguridad." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontSize=12;fontColor=#334155;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="795" y="735" width="710" height="165" as="geometry"/>
        </mxCell>

