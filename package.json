{
  "name": "vehimarcas-catalogo-web",
  "version": "1.0.0",
  "type": "module",
  "description": "Aplicación web Full Stack para la gestión y publicación del catálogo de vehículos de VEHIMARCAS del Valle, desarrollada con Vite y Supabase.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "db:setup": "node server/setup-db.mjs",
    "supabase:status": "supabase migration list",
    "supabase:push:dry": "supabase db push --dry-run",
    "supabase:push": "supabase db push",
    "supabase:test-db": "supabase test db --linked",
    "test:auth": "node --test",
    "test": "npm run supabase:test-db && npm run test:auth"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marlonstv120/vehimarcas-catalogo-web.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/marlonstv120/vehimarcas-catalogo-web/issues"
  },
  "homepage": "https://github.com/marlonstv120/vehimarcas-catalogo-web#readme",
  "devDependencies": {
    "supabase": "^2.117.0",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "lucide": "^1.54.0",
    "motion": "^14.1.0"
  }
}
